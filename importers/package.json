{
  "name": "@crate/importers",
  "version": "0.1.0",
  "description": "One-time CLI import harness for crate.social — RSS, markdown, and future sources.",
  "private": true,
  "type": "module",
  "bin": {
    "importers": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lexgen": "echo 'TODO: run @atproto/lex-cli gen-api against ../../lexicons and output to src/lexicon/'"
  },
  "dependencies": {
    "@atproto/api": "^0.18.3",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
}
