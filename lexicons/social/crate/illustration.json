{
  "lexicon": 1,
  "id": "social.crate.illustration",
  "defs": {
    "main": {
      "type": "record",
      "description": "A stick-figure illustration or piece of artwork.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["caption", "image", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxGraphemes": 200,
            "maxLength": 2000,
            "description": "Optional title for the illustration."
          },
          "caption": {
            "type": "string",
            "maxGraphemes": 1000,
            "maxLength": 10000,
            "description": "Caption or alt text describing the illustration."
          },
          "image": {
            "type": "blob",
            "description": "The illustration image file.",
            "accept": ["image/jpeg", "image/png", "image/webp", "image/gif", "image/svg+xml"],
            "maxSize": 2000000
          },
          "topic": {
            "type": "string",
            "maxGraphemes": 200,
            "maxLength": 2000,
            "description": "Subject or topic the illustration depicts."
          },
          "sourcePost": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the post or note this illustration was originally created for, if any."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when this record was created."
          }
        }
      }
    }
  }
}
