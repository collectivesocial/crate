# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────
# Postgres connection string.  Local dev uses docker-compose defaults.
DATABASE_URL=postgresql://crate:crate@localhost:5432/crate

# ── OAuth ────────────────────────────────────────────────────────────────
# Public URL of this API — used as the ATProto OAuth client_id base.
# Set to http://localhost:3000 in local dev (loopback / no keyset required).
# Set to https://api.crate.social in production.
SERVICE_URL=http://localhost:3000

# ATProto PLC directory URL
PLC_URL=https://plc.directory

# Default PDS for handle resolution (users may be on any PDS)
PDS_URL=https://bsky.social

# JWK keyset (array of JWK objects) for confidential-client signing.
# Generate with: node -e "const {JoseKey} = require('@atproto/oauth-client-node'); JoseKey.generate(['ES256']).then(k => console.log(JSON.stringify([k.privateJwk])))"
# Leave empty for loopback dev mode.
# PRIVATE_KEYS=[]

# Cookie secret for iron-session (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# ── CORS ─────────────────────────────────────────────────────────────────
# Origin of the web app.  web/ is served from GitHub Pages in production.
# In development, Vite runs on localhost:5173.
CORS_ORIGIN=http://localhost:5173
