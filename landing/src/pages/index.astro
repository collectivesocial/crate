---
import Base from '../layouts/Base.astro';

const appUrl = 'https://app.crate.social';
const githubUrl = 'https://github.com/brittanyellich/crate';

const features = [
  {
    title: 'Custom lexicons, your namespace',
    body: 'Crate ships a catalog of structured record types under social.crate.* — notes, projects, content, now-pages — so every thing you make has a stable shape.',
  },
  {
    title: 'Import from anywhere',
    body: 'Subscribe to RSS feeds, drop in markdown, or enter records by hand. Crate normalizes them into ATProto records on your PDS.',
  },
  {
    title: 'Read API for any frontend',
    body: 'Your personal site, a feed reader, a static export — all of them can query Crate to render your records however they want.',
  },
  {
    title: 'You own the data',
    body: 'Records live on your ATProto PDS. Crate is the publishing pipeline; your account is the source of truth.',
  },
];

const recordTypes = [
  { name: 'note', desc: 'Markdown notes & backlinks' },
  { name: 'content', desc: 'Articles, talks, podcasts, illustrations' },
  { name: 'making.project', desc: 'Projects with progress updates' },
  { name: 'now', desc: 'Append-only now-page stream' },
  { name: 'rss.feed', desc: 'Subscribed feeds with destinations' },
];
---

<Base
  title="crate.social — publish structured records to your ATProto PDS"
  description="Crate is a custom-lexicon publishing service for ATProto. Define your record types, import from anywhere, query from everywhere."
>
  <div class="relative isolate min-h-screen overflow-hidden">
    <!-- soft gradient grid backdrop -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]"
    >
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:48px_48px]"
      >
      </div>
    </div>

    <!-- nav -->
    <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-brand-500/15 text-brand-300 ring-1 ring-brand-500/30">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </span>
        <span class="text-white">crate.social</span>
      </a>
      <nav class="flex items-center gap-2 sm:gap-4">
        <a
          href={githubUrl}
          class="hidden text-sm text-white/70 transition hover:text-white sm:inline-block"
        >
          GitHub
        </a>
        <a
          href={appUrl}
          class="inline-flex items-center gap-1.5 rounded-md bg-white px-4 py-2 text-sm font-medium text-slate-900 shadow-sm transition hover:bg-white/90"
        >
          Log in
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M7.21 14.77a.75.75 0 0 1 .02-1.06L10.94 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.25 4.25a.75.75 0 0 1 0 1.08l-4.25 4.25a.75.75 0 0 1-1.06-.02Z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </nav>
    </header>

    <!-- hero -->
    <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24 sm:pb-32">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-white/70"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
          Built on ATProto
        </span>
        <h1
          class="mt-6 text-balance text-4xl font-semibold tracking-tight text-white sm:text-6xl"
        >
          Publish structured records to your
          <span class="bg-gradient-to-r from-brand-300 via-brand-400 to-brand-500 bg-clip-text text-transparent">
            ATProto PDS.
          </span>
        </h1>
        <p
          class="mt-6 text-pretty text-lg leading-relaxed text-white/70 sm:text-xl"
        >
          Crate defines lexicons for the things you make — notes, projects,
          podcast episodes, talks, now-page updates — imports them from RSS,
          markdown, or manual entry, and exposes a read API any frontend can
          consume.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href={appUrl}
            class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition hover:bg-brand-400"
          >
            Log in to Crate
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M7.21 14.77a.75.75 0 0 1 .02-1.06L10.94 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.25 4.25a.75.75 0 0 1 0 1.08l-4.25 4.25a.75.75 0 0 1-1.06-.02Z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href={githubUrl}
            class="inline-flex items-center gap-2 rounded-md border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white/90 transition hover:bg-white/10"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- features -->
    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          features.map((f) => (
            <article class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur transition hover:border-white/20 hover:bg-white/[0.07]">
              <h2 class="text-base font-semibold text-white">{f.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-white/70">{f.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- record types -->
    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-10"
      >
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-2xl font-semibold tracking-tight text-white">
              The <code class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-base text-brand-200">social.crate.*</code> namespace
            </h2>
            <p class="mt-2 max-w-xl text-sm text-white/60">
              A small, intentional catalog of record types — enough to model a
              maker&rsquo;s online output without sprawl.
            </p>
          </div>
        </div>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            recordTypes.map((r) => (
              <li class="flex flex-col gap-1 rounded-lg border border-white/10 bg-black/30 p-4">
                <code class="font-mono text-sm text-brand-200">
                  social.crate.{r.name}
                </code>
                <span class="text-sm text-white/60">{r.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-6 pb-32">
      <div
        class="relative overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-600/20 via-brand-500/10 to-transparent p-8 sm:p-12"
      >
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="max-w-xl">
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
              Ready to crate it up?
            </h2>
            <p class="mt-2 text-white/70">
              Log in with your ATProto account to start importing feeds and
              publishing records to your PDS.
            </p>
          </div>
          <a
            href={appUrl}
            class="inline-flex shrink-0 items-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-white/90"
          >
            Log in
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M7.21 14.77a.75.75 0 0 1 .02-1.06L10.94 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.25 4.25a.75.75 0 0 1 0 1.08l-4.25 4.25a.75.75 0 0 1-1.06-.02Z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- footer -->
    <footer class="mx-auto max-w-6xl px-6 pb-12">
      <div
        class="flex flex-col items-center justify-between gap-2 border-t border-white/10 pt-6 text-sm text-white/50 sm:flex-row"
      >
        <p>&copy; {new Date().getFullYear()} crate.social</p>
        <div class="flex items-center gap-4">
          <a href={githubUrl} class="transition hover:text-white">GitHub</a>
          <a href="https://atproto.com" class="transition hover:text-white">
            ATProto
          </a>
        </div>
      </div>
    </footer>
  </div>
</Base>
